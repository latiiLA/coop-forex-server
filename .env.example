JWT_SECRET=
REFRESH_JWT_SECRET=
MONGO_URL=
TIMEOUT=
DB_NAME=

DISABLE_MIGRATION=
FILE_UPLOAD_PATH=
Log_LEVEL=info

MAIL_SERVER=
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_PORT=

LDAP_HOST=
LDAP_PORT=
LDAP_BASE_DN=
LDAP_BIND_USER=
LDAP_BIND_PASSWORD=
# StartTLS on 389 / LDAPS on 636. Use false if AD does not expose StartTLS yet.
LDAP_USE_TLS=false
# Set true only for lab/self-signed LDAP certs when LDAP_USE_TLS=true
LDAP_TLS_INSECURE=false

CERT_FILE=
KEY_FILE=

# Comma-separated frontend origins. Do NOT use * (credentials are enabled).
ALLOWED_ORIGINS=https://forex.example.com,http://localhost:5173
# Comma-separated proxy IPs/CIDRs for ClientIP (JWT bind + rate limit). Defaults to localhost.
TRUSTED_PROXIES=127.0.0.1,::1
# Set true only for lab/self-signed SMTP certs
MAIL_TLS_INSECURE=false
# Optional: debug|release|test. Defaults to release when unset.
# GIN_MODE=release